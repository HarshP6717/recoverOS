# ==============================================================================
# RecoverOS Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# AI Provider Configuration ("mock" for deterministic local sandbox, "gemini" for live LLM)
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Test Mode API Credentials
RAZORPAY_TEST_MODE=true
RAZORPAY_LIVE_EXECUTION=false
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Database Configuration
DATABASE_URL=sqlite:///backend/recoveros_ledger.db

# Webhook Replay Protection (tolerance in seconds, 0 to disable)
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173
